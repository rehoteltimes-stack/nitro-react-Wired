diff --git a/nitro/avatar/data/HabboAvatarExtraParts.ts b/nitro/avatar/data/HabboAvatarExtraParts.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67beed0f6e1f18c51954215ff51dffcb6fe1c935
--- /dev/null
+++ b/nitro/avatar/data/HabboAvatarExtraParts.ts
@@ -0,0 +1,62 @@
+const GEOMETRY_TYPES = [ 'vertical', 'sitting', 'horizontal', 'swhorizontal' ];
+
+const BODY_PART_ITEMS: { [bodyPart: string]: [ string, number ][] } = {
+    'torso': [ [ 'pt', 0.08 ], [ 'mc', 0.09 ] ],
+    'leftarm': [ [ 'ptl', 0.03 ], [ 'mcl', 0.04 ] ],
+    'rightarm': [ [ 'ptr', 0.03 ], [ 'mcr', 0.04 ] ]
+};
+
+const PART_SETS = [
+    { 'setType': 'pt' },
+    { 'setType': 'ptl', 'flippedSetType': 'ptr' },
+    { 'setType': 'ptr', 'flippedSetType': 'ptl' },
+    { 'setType': 'mc' },
+    { 'setType': 'mcl', 'flippedSetType': 'mcr' },
+    { 'setType': 'mcr', 'flippedSetType': 'mcl' }
+];
+
+export const AddExtraGeometryParts = (geometry: any) =>
+{
+    for(const type of geometry.types)
+    {
+        if(GEOMETRY_TYPES.indexOf(type.id) === -1) continue;
+
+        for(const bodyPart of type.bodyParts)
+        {
+            const extra = BODY_PART_ITEMS[bodyPart.id];
+
+            if(!extra) continue;
+
+            if(!bodyPart.items) bodyPart.items = [];
+
+            for(const [ id, radius ] of extra)
+            {
+                if(bodyPart.items.some(item => (item.id === id))) continue;
+
+                bodyPart.items.push({ 'id': id, 'x': 0, 'y': 0, 'z': 0, 'radius': radius, 'nx': 0, 'ny': 0, 'nz': -1, 'double': false });
+            }
+        }
+    }
+
+    return geometry;
+};
+
+export const AddExtraPartSets = (partSets: any) =>
+{
+    for(const partSet of PART_SETS)
+    {
+        if(!partSets.partSet.some(existing => (existing.setType === partSet.setType))) partSets.partSet.push({ ...partSet });
+    }
+
+    const figure = partSets.activePartSets.find(activePartSet => (activePartSet.id === 'figure'));
+
+    if(figure)
+    {
+        for(const partSet of PART_SETS)
+        {
+            if(!figure.activeParts.some(existing => (existing.setType === partSet.setType))) figure.activeParts.push({ 'setType': partSet.setType });
+        }
+    }
+
+    return partSets;
+};
