diff --git a/nitro/room/object/visualization/avatar/AvatarAuraRegistry.ts b/nitro/room/object/visualization/avatar/AvatarAuraRegistry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2ab54acdcfc416db0a2dc28afca11b80c871f642
--- /dev/null
+++ b/nitro/room/object/visualization/avatar/AvatarAuraRegistry.ts
@@ -0,0 +1,58 @@
+import { Filter } from '@pixi/core';
+
+/**
+ * Aura hook: an avatar whose room object has RoomObjectVariable.FIGURE_AURA > 0 asks the registered provider for the
+ * filters to put on its avatar sprite. The renderer itself draws nothing; an add-on (e.g. a shop module) registers a
+ * provider with its own effects. No provider, or a provider that returns null, means no aura.
+ */
+export interface IAvatarAuraProvider
+{
+    /** Filters for this aura at this moment (time in ms), or null when the id is unknown. */
+    getFilters(auraId: number, time: number, scale: number): Filter[];
+
+    /** True when the aura moves on its own, so the avatar keeps being redrawn while it stands still. */
+    isAnimated(auraId: number): boolean;
+}
+
+export class AvatarAuraRegistry
+{
+    private static _provider: IAvatarAuraProvider = null;
+
+    public static get provider(): IAvatarAuraProvider
+    {
+        return AvatarAuraRegistry._provider;
+    }
+
+    public static set provider(provider: IAvatarAuraProvider)
+    {
+        AvatarAuraRegistry._provider = provider;
+    }
+
+    public static getFilters(auraId: number, time: number, scale: number): Filter[]
+    {
+        if(!auraId || !AvatarAuraRegistry._provider) return null;
+
+        try
+        {
+            return AvatarAuraRegistry._provider.getFilters(auraId, time, scale) || null;
+        }
+        catch (error)
+        {
+            return null;
+        }
+    }
+
+    public static isAnimated(auraId: number): boolean
+    {
+        if(!auraId || !AvatarAuraRegistry._provider) return false;
+
+        try
+        {
+            return AvatarAuraRegistry._provider.isAnimated(auraId);
+        }
+        catch (error)
+        {
+            return false;
+        }
+    }
+}
