+            isWaitingForMouseDown = true;
+        }
+
+        // Some tile interactions arrive as a held-button move before a tile MOUSE_DOWN is dispatched.
+        if((this._state === RoomAreaSelectionManager.AWAITING_MOUSE_DOWN) && event.buttonDown && (event.type === RoomObjectMouseEvent.MOUSE_MOVE))
