+            const avatarRotation = (unitRollData.rotation >= 0) ? ((unitRollData.rotation % 8) * 45) : NaN;
+            const direction = !isNaN(avatarRotation) ? new Vector3d(avatarRotation) : (((unitRollData.movementType === ObjectRolling.MOVE) && object) ? object.getDirection() : null);
+            const headDirection = !isNaN(avatarRotation) ? avatarRotation : NaN;
+            const continueFromCurrent = (unitRollData.movementType === ObjectRolling.MOVE) && !(unitRollData.animationTimeMs > 0);
