+        this._isDecorating = false;
+        this._isSpectator = false;
+
+        this._moderationSettings = null;
+    }
+
+    protected onDispose(): void
+    {
+        if(this._userData)
+        {
+            this._userData.dispose();
+
+            this._userData = null;
+        }
+
+        this._connection = null;
+    }
