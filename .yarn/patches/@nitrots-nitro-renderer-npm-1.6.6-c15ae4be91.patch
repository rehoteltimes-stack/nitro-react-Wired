+
+    public getDefaultPartSet(gender: string): IFigurePartSet
+    {
+        for(const set of this._partSets.getValues())
+        {
+            if(!set) continue;
+
+            if((set.clubLevel === 0) && ((set.gender === gender) || (set.gender === 'U'))) return set;
+        }
+
+        return null;
+    }
