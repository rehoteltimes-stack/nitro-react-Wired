+    {
+        this._itemId = 0;
+        this._data = null;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        this._itemId = parseInt(wrapper.readString());
+        this._data = FurnitureDataParser.parseObjectData(wrapper);
+
+        return true;
+    }
