+            this._eventCache = null;
+        }
+
+        this._mouseListener = null;
+    }
+
+    public initialize(width: number, height: number): void
+    {
+        width = width < 1 ? 1 : width;
+        height = height < 1 ? 1 : height;
+
+        if(this._usesMask)
+        {
+            if(!this._mask)
+            {
+                this._mask = new Graphics()
+                    .beginFill(0xFF0000)
+                    .drawRect(0, 0, width, height)
+                    .endFill();
