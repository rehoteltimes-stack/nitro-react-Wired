+import { IVector3D } from '../../../room';
+
+export class ObjectRolling
+{
+    public static MOVE: string = 'mv';
+    public static SLIDE: string = 'sld';
+
+    private _id: number;
+    private _location: IVector3D;
+    private _targetLocation: IVector3D;
+    private _movementType: string;
+    private _movementCurve: number;
+    private _lateralMovementCurve: number;
+    private _bounceCount: number;
+    private _animationTimeMs: number;
+    private _rotation: number;
+    private _suppressRotationBounce: boolean;
+
+    constructor(id: number, location: IVector3D, targetLocation: IVector3D, movementType: string = null, movementCurve: number = 0, lateralMovementCurve: number = 0, bounceCount: number = 0, animationTimeMs: number = 0, rotation: number = -1, suppressRotationBounce: boolean = false)
+    {
+        this._id = id;
+        this._location = location;
+        this._targetLocation = targetLocation;
+        this._movementType = movementType;
+        this._movementCurve = movementCurve;
+        this._lateralMovementCurve = lateralMovementCurve;
+        this._bounceCount = bounceCount;
+        this._animationTimeMs = animationTimeMs;
+        this._rotation = rotation;
+        this._suppressRotationBounce = suppressRotationBounce;
+    }
+
+    public get id(): number
+    {
+        return this._id;
+    }
+
+    public get location(): IVector3D
+    {
+        return this._location;
+    }
+
+    public get targetLocation(): IVector3D
+    {
+        return this._targetLocation;
+    }
+
+    public get movementType(): string
+    {
+        return this._movementType;
+    }
+
+    public get movementCurve(): number
+    {
+        return this._movementCurve;
+    }
+
+    public get lateralMovementCurve(): number
+    {
+        return this._lateralMovementCurve;
+    }
+
+    public get bounceCount(): number
+    {
+        return this._bounceCount;
+    }
+
+    public get animationTimeMs(): number
+    {
+        return this._animationTimeMs;
+    }
+
+    public get rotation(): number
+    {
+        return this._rotation;
+    }
+
+    public get suppressRotationBounce(): boolean
+    {
+        return this._suppressRotationBounce;
+    }
+}
