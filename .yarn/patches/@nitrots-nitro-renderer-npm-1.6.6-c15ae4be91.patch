+
+                if(setId >= 0)
+                {
+                    let i = 0;
+
+                    while(i < colors.length)
+                    {
+                        set = (set + ('-' + colors[i]));
+
+                        i++;
+                    }
+                }
+
+                sets.push(set);
+            }
+        }
+
+        let i = 0;
+
+        while(i < sets.length)
+        {
+            figure = (figure + sets[i]);
+
+            if(i < (sets.length - 1)) figure = (figure + '.');
+
