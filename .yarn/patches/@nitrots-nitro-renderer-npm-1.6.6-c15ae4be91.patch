new file mode 100644
index 0000000000000000000000000000000000000000..66d9d0bb05e9a2f1059035ef8618aa4e1a8916b9
--- /dev/null
+++ b/nitro/communication/messages/outgoing/room/furniture/FurniturePlaceComposer.ts
@@ -0,0 +1,39 @@
+import { IMessageComposer, RoomObjectCategory } from '../../../../../../api';
+
+export class FurniturePlaceComposer implements IMessageComposer<string[]>
+{
+    private _itemId: number;
+    private _category: number;
+    private _wallLocation: string;
+    private _x: number;
+    private _y: number;
+    private _direction: number;
+
+    constructor(itemId: number, category: number, wallLocation: string, x: number, y: number, direction: number)
+    {
+        this._itemId = itemId;
+        this._category = category;
+        this._wallLocation = wallLocation;
+        this._x = x;
+        this._y = y;
+        this._direction = direction;
+    }
+
+    public getMessageArray()
+    {
+        switch(this._category)
+        {
+            case RoomObjectCategory.FLOOR:
+                return [`${this._itemId} ${this._x} ${this._y} ${this._direction}`];
+            case RoomObjectCategory.WALL:
+                return [`${this._itemId} ${this._wallLocation} `];
+            default:
+                return [];
+        }
+    }
+
+    public dispose(): void
+    {
+        return;
+    }
+}
