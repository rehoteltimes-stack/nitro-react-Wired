+import { IMessageDataWrapper, IMessageParser } from '../../../../../../api';
+import { FurnitureDataParser } from '../furniture';
+import { ObjectData } from './ObjectData';
+
+export class ObjectsDataUpdateParser implements IMessageParser
+{
+    private _objects: ObjectData[];
+
+    public flush(): boolean
+    {
+        this._objects = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        let totalObjects = wrapper.readInt();
+
+        while(totalObjects > 0)
+        {
+            const id = wrapper.readInt();
+            const stuffData = FurnitureDataParser.parseObjectData(wrapper);
+            const state = parseFloat(stuffData.getLegacyString());
+
+            this._objects.push(new ObjectData(id, state, stuffData));
+
+            totalObjects--;
+        }
+
+        return true;
+    }
+
+    public get objects(): ObjectData[]
+    {
+        return this._objects;
+    }
+}
diff --git a/nitro/communication/messages/parser/room/engine/ObjectsRollingParser.ts b/nitro/communication/messages/parser/room/engine/ObjectsRollingParser.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1f6462293bcf995bdbb59102b795a24b28b2fa10
--- /dev/null
+++ b/nitro/communication/messages/parser/room/engine/ObjectsRollingParser.ts
@@ -0,0 +1,99 @@
+import { IMessageDataWrapper, IMessageParser, ObjectRolling, Vector3d } from '../../../../../../api';
+
+export class ObjectsRollingParser implements IMessageParser
+{
+    private _rollerId: number;
+    private _itemsRolling: ObjectRolling[];
+    private _unitRolling: ObjectRolling;
+
+    public flush(): boolean
+    {
+        this._rollerId = 0;
+
+        this._itemsRolling = [];
+        this._unitRolling = null;
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        const x = wrapper.readInt();
+        const y = wrapper.readInt();
+        const nextX = wrapper.readInt();
+        const nextY = wrapper.readInt();
+
+        let totalItems = wrapper.readInt();
+
+        while(totalItems > 0)
+        {
+            const id = wrapper.readInt();
+            const height = parseFloat(wrapper.readString());
+            const nextHeight = parseFloat(wrapper.readString());
+            const rollingData = new ObjectRolling(id, new Vector3d(x, y, height), new Vector3d(nextX, nextY, nextHeight));
+
+            this._itemsRolling.push(rollingData);
+
+            totalItems--;
+        }
+
+        this._rollerId = wrapper.readInt();
+
+        if(!wrapper.bytesAvailable) return true;
+
+        const movementType = wrapper.readInt();
+
+        if(movementType === -1)
+        {
+            const movementCurve = wrapper.readInt();
+            const lateralMovementCurve = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+            const bounceCount = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+            const animationTimeMs = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+            const rotation = wrapper.bytesAvailable ? wrapper.readInt() : -1;
+            const suppressRotationBounce = wrapper.bytesAvailable ? wrapper.readBoolean() : false;
+
+            this._itemsRolling = this._itemsRolling.map(rollingData => new ObjectRolling(rollingData.id, rollingData.location, rollingData.targetLocation, rollingData.movementType, movementCurve, lateralMovementCurve, bounceCount, animationTimeMs, rotation, suppressRotationBounce));
+
+            return true;
+        }
+
+        const unitId = wrapper.readInt();
+        const height = parseFloat(wrapper.readString());
+        const nextHeight = parseFloat(wrapper.readString());
+        const movementCurve = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+        const lateralMovementCurve = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+        const bounceCount = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+        const animationTimeMs = wrapper.bytesAvailable ? wrapper.readInt() : 0;
+        const rotation = wrapper.bytesAvailable ? wrapper.readInt() : -1;
+
+        switch(movementType)
+        {
+            case 0: break;
+            case 1:
+                this._unitRolling = new ObjectRolling(unitId, new Vector3d(x, y, height), new Vector3d(nextX, nextY, nextHeight), ObjectRolling.MOVE, movementCurve, lateralMovementCurve, bounceCount, animationTimeMs, rotation);
+                break;
+            case 2:
+                this._unitRolling = new ObjectRolling(unitId, new Vector3d(x, y, height), new Vector3d(nextX, nextY, nextHeight), ObjectRolling.SLIDE, movementCurve, lateralMovementCurve, bounceCount, animationTimeMs, rotation);
+                break;
+        }
+
+        return true;
+    }
+
+    public get rollerId(): number
+    {
+        return this._rollerId;
+    }
+
+    public get itemsRolling(): ObjectRolling[]
+    {
+        return this._itemsRolling;
+    }
+
+    public get unitRolling(): ObjectRolling
+    {
+        return this._unitRolling;
+    }
+}
diff --git a/nitro/communication/messages/parser/room/engine/WiredMovementsParser.ts b/nitro/communication/messages/parser/room/engine/WiredMovementsParser.ts
new file mode 100644
index 0000000000000000000000000000000000000000..44158952d34e1299aa719fce23987f758837a97c
--- /dev/null
+++ b/nitro/communication/messages/parser/room/engine/WiredMovementsParser.ts
@@ -0,0 +1,130 @@
+import { IMessageDataWrapper, IMessageParser, ObjectRolling, Vector3d } from '../../../../../../api';
+
+export class WiredMovementsParser implements IMessageParser
+{
+    public static TYPE_USER_MOVE = 0;
+    public static TYPE_FURNI_MOVE = 1;
+    public static TYPE_WALL_ITEM_MOVE = 2;
+    public static TYPE_USER_DIRECTION = 3;
+
+    private _itemsRolling: ObjectRolling[];
+    private _unitRolling: ObjectRolling[];
+    private _unitDirections: { id: number; headDirection: number; bodyDirection: number }[];
+
+    public flush(): boolean
+    {
+        this._itemsRolling = [];
+        this._unitRolling = [];
+        this._unitDirections = [];
+
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        let count = wrapper.readInt();
+
+        while(count > 0)
+        {
+            const type = wrapper.readInt();
+
+            switch(type)
+            {
+                case WiredMovementsParser.TYPE_FURNI_MOVE:
+                    this.parseFurniMove(wrapper);
+                    break;
+                case WiredMovementsParser.TYPE_USER_MOVE:
+                    this.parseUserMove(wrapper);
+                    break;
+                case WiredMovementsParser.TYPE_WALL_ITEM_MOVE:
+                    this.skipWallItemMove(wrapper);
+                    break;
+                case WiredMovementsParser.TYPE_USER_DIRECTION:
+                    this.parseUserDirection(wrapper);
+                    break;
+            }
+
+            count--;
+        }
+
+        return true;
+    }
+
+    private parseFurniMove(wrapper: IMessageDataWrapper): void
+    {
+        const fromX = wrapper.readInt();
+        const fromY = wrapper.readInt();
+        const toX = wrapper.readInt();
+        const toY = wrapper.readInt();
+        const fromZ = parseFloat(wrapper.readString());
+        const toZ = parseFloat(wrapper.readString());
+        const id = wrapper.readInt();
+        const rotation = wrapper.readInt();
+        const movementCurve = wrapper.readInt();
+        const lateralMovementCurve = wrapper.readInt();
+        const bounceCount = wrapper.readInt();
+        const animationTimeMs = wrapper.readInt();
+        const suppressRotationBounce = wrapper.readBoolean();
+
+        wrapper.readInt();
+        wrapper.readInt();
+
+        this._itemsRolling.push(new ObjectRolling(id, new Vector3d(fromX, fromY, fromZ), new Vector3d(toX, toY, toZ), ObjectRolling.MOVE, movementCurve, lateralMovementCurve, bounceCount, animationTimeMs, rotation, suppressRotationBounce));
+    }
+
+    private parseUserMove(wrapper: IMessageDataWrapper): void
+    {
+        const fromX = wrapper.readInt();
+        const fromY = wrapper.readInt();
+        const toX = wrapper.readInt();
+        const toY = wrapper.readInt();
+        const fromZ = parseFloat(wrapper.readString());
+        const toZ = parseFloat(wrapper.readString());
+        const id = wrapper.readInt();
+        // Habbo AIR user-move record order: movementType, animationTime,
+        // bodyDirection, headDirection, hasJumpPower[, jumpPower].
+        const movementType = wrapper.readInt();
+        const duration = wrapper.readInt();
+        const bodyDirection = wrapper.readInt();
+        wrapper.readInt(); // headDirection (body direction is reused for the head)
+        const hasJumpPower = wrapper.readBoolean();
+
+        if(hasJumpPower) wrapper.readInt();
+
+        this._unitRolling.push(new ObjectRolling(id, new Vector3d(fromX, fromY, fromZ), new Vector3d(toX, toY, toZ), movementType === 1 ? ObjectRolling.SLIDE : ObjectRolling.MOVE, 0, 0, 0, duration, bodyDirection));
+    }
+
+    private skipWallItemMove(wrapper: IMessageDataWrapper): void
+    {
+        wrapper.readInt();
+        wrapper.readBoolean();
+
+        for(let index = 0; index < 9; index++) wrapper.readInt();
+    }
+
+    private parseUserDirection(wrapper: IMessageDataWrapper): void
+    {
+        const id = wrapper.readInt();
+        const headDirection = wrapper.readInt();
+        const bodyDirection = wrapper.readInt();
+
+        this._unitDirections.push({ id, headDirection, bodyDirection });
+    }
+
+    public get itemsRolling(): ObjectRolling[]
+    {
+        return this._itemsRolling;
+    }
+
+    public get unitRolling(): ObjectRolling[]
+    {
+        return this._unitRolling;
+    }
+
+    public get unitDirections(): { id: number; headDirection: number; bodyDirection: number }[]
+    {
+        return this._unitDirections;
+    }
+}
