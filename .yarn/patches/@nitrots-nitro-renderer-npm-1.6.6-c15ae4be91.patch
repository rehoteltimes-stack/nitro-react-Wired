+            this._roomCreator.updateRoomObjectUserLocation(this._currentRoomId, unitRollData.id, location, targetLocation, false, 0, direction, headDirection, unitRollData.movementCurve, unitRollData.lateralMovementCurve, unitRollData.bounceCount, unitRollData.animationTimeMs, continueFromCurrent, unitRollData.movementType === ObjectRolling.SLIDE);
