@@ -0,0 +1,121 @@
+import { IMessageDataWrapper } from '../../../../../api';
+import { Triggerable } from './Triggerable';
+
+export interface VariableDefinitionField
+{
+    id: number;
+    name: string;
+    order: number;
+}
+
+export class VariableDefinition extends Triggerable
+{
+    private _variableType: number;
+    private _variableName: string;
+    private _persistence: number;
+    private _value: string;
+    private _schemaVersion: number;
+    private _valueShape: number;
+    private _arrayFormat: number;
+    private _arrayMode: number;
+    private _maxEntries: number;
+    private _nextFieldId: number;
+    private _serverMaxEntries: number;
+    private _serverMaxPopulatedCells: number;
+    private _fields: VariableDefinitionField[];
+
+    constructor(wrapper: IMessageDataWrapper)
+    {
+        super(wrapper);
+
+        this._variableType = wrapper.readInt();
+        this._variableName = wrapper.readString();
+        this._persistence = wrapper.readInt();
+        this._value = wrapper.readString();
+        this._schemaVersion = wrapper.readInt();
+        this._valueShape = wrapper.readInt();
+        this._arrayFormat = wrapper.readInt();
+        this._arrayMode = wrapper.readInt();
+        this._maxEntries = wrapper.readInt();
+        this._nextFieldId = wrapper.readInt();
+        this._serverMaxEntries = wrapper.readInt();
+        this._serverMaxPopulatedCells = wrapper.readInt();
+        this._fields = [];
+
+        const fieldCount = wrapper.readInt();
+        for(let index = 0; index < fieldCount; index++)
+        {
+            this._fields.push({
+                id: wrapper.readInt(),
+                name: wrapper.readString(),
+                order: wrapper.readInt()
+            });
+        }
+        this.readCanModify(wrapper);
+    }
+
+    public get code(): number
+    {
+        return this._variableType;
+    }
+
+    public get variableName(): string
+    {
+        return this._variableName;
+    }
+
+    public get persistence(): number
+    {
+        return this._persistence;
+    }
+
+    public get value(): string
+    {
+        return this._value;
+    }
+
+    public get schemaVersion(): number
+    {
+        return this._schemaVersion;
+    }
+
+    public get valueShape(): number
+    {
+        return this._valueShape;
+    }
+
+    public get arrayFormat(): number
+    {
+        return this._arrayFormat;
+    }
+
+    public get arrayMode(): number
+    {
+        return this._arrayMode;
+    }
+
+    public get maxEntries(): number
+    {
+        return this._maxEntries;
+    }
+
+    public get nextFieldId(): number
+    {
+        return this._nextFieldId;
+    }
+
+    public get serverMaxEntries(): number
+    {
+        return this._serverMaxEntries;
+    }
+
+    public get serverMaxPopulatedCells(): number
+    {
+        return this._serverMaxPopulatedCells;
+    }
+
+    public get fields(): VariableDefinitionField[]
+    {
+        return this._fields;
+    }
+}
