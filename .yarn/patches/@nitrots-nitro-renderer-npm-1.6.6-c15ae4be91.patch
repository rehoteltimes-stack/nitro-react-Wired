--- /dev/null
+++ b/nitro/room/object/visualization/furniture/FurnitureFurniChestVisualization.ts
@@ -0,0 +1,301 @@
+import { SCALE_MODES } from '@pixi/constants';
+import { SCALE_MODES } from '@pixi/constants';
+import { Texture } from '@pixi/core';
+import { AlphaTolerance, IRoomObjectSprite, RoomObjectVariable, RoomObjectVisualizationType } from '../../../../../api';
+import { Nitro } from '../../../../Nitro';
+import { FurnitureAnimatedVisualization } from './FurnitureAnimatedVisualization';
+
+type FurniChestPreviewItem = {
+    type: string;
+    classId: number;
+    extra: string;
+};
+
+export class FurnitureFurniChestVisualization extends FurnitureAnimatedVisualization
+{
+    public static TYPE: string = RoomObjectVisualizationType.FURNITURE_FURNICHEST;
+
+    private static PREVIEW_LAYER_COUNT: number = 4;
+    private static PREVIEW_TAG: string = 'wired_emblem';
+
+    private _previewItems: FurniChestPreviewItem[];
+    private _previewTextures: Texture[];
+    private _previewSignature: string;
+    private _previewDirty: boolean;
+    private _previewTick: number;
+    private _previewLayoutVariant: number;
+
+    constructor()
+    {
+        super();
+
+        this._previewItems = [];
+        this._previewTextures = [];
+        this._previewSignature = '';
+        this._previewDirty = false;
+        this._previewTick = 0;
+        this._previewLayoutVariant = 0;
+    }
+
+    public dispose(): void
+    {
+        super.dispose();
+
+        this._previewItems = null;
+        this._previewTextures = null;
+    }
+
+    protected updateModel(scale: number): boolean
+    {
+        const updated = super.updateModel(scale);
+        const data = this.object && this.object.model && this.object.model.getValue<string>(RoomObjectVariable.FURNITURE_DATA);
+        const signature = data || '';
+
+        if(signature !== this._previewSignature)
+        {
+            this._previewSignature = signature;
+            this._previewItems = this.parsePreviewItems(signature);
+            this._previewTextures = [];
+            this._previewDirty = true;
+            this._previewLayoutVariant = Math.floor(Math.random() * 4);
+
+            this.loadPreviewTextures();
+        }
+
+        return updated || this._previewDirty;
+    }
+
+    protected updateAnimation(scale: number): number
+    {
+        let update = super.updateAnimation(scale);
+
+        if(this.isOpen() && this._previewItems && this._previewItems.length)
+        {
+            this._previewTick++;
+            update = update | this.getPreviewLayerMask();
+        }
+
+        if(this._previewDirty)
+        {
+            this._previewDirty = false;
+            update = update | this.getPreviewLayerMask();
+        }
+
+        return update;
+    }
+
+    protected updateSprite(scale: number, layerId: number): void
+    {
+        if(this.isPreviewLayer(layerId))
+        {
+            this.updatePreviewSprite(scale, layerId);
+            return;
+        }
+
+        super.updateSprite(scale, layerId);
+    }
+
+    protected getAdditionalLayerCount(): number
+    {
+        return super.getAdditionalLayerCount() + FurnitureFurniChestVisualization.PREVIEW_LAYER_COUNT;
+    }
+
+    private updatePreviewSprite(scale: number, layerId: number): void
+    {
+        const sprite = this.getSprite(layerId);
+
+        if(!sprite) return;
+
+        const slot = layerId - this._shadowLayerIndex - 1;
+        const texture = this._previewTextures && this._previewTextures[slot];
+
+        if(!this.isOpen() || !texture)
+        {
+            this.resetPreviewSprite(sprite);
+            return;
+        }
+
+        const offset = this.getPreviewOffset(slot, scale);
+        const hover = Math.round(Math.sin((this._previewTick + (slot * 9)) / 10) * 3);
+
+        sprite.visible = true;
+        sprite.type = this._type;
+        sprite.texture = texture;
+        sprite.flipH = false;
+        sprite.flipV = false;
+        sprite.direction = this._direction;
+        sprite.tag = FurnitureFurniChestVisualization.PREVIEW_TAG;
+        sprite.alpha = this.getPreviewAlpha(slot);
+        sprite.color = 0xFFFFFF;
+        sprite.offsetX = offset.x;
+        sprite.offsetY = offset.y + hover;
+        sprite.blendMode = 0;
+        sprite.alphaTolerance = AlphaTolerance.MATCH_OPAQUE_PIXELS;
+        sprite.relativeDepth = -0.004 - (slot * 0.0002);
+        sprite.name = `furnichest_preview_${ slot }`;
+        sprite.libraryAssetName = sprite.name;
+        sprite.posture = '';
+        sprite.clickHandling = false;
+    }
+
+    private resetPreviewSprite(sprite: IRoomObjectSprite): void
+    {
+        sprite.visible = false;
+        sprite.texture = null;
+        sprite.name = '';
+        sprite.libraryAssetName = '';
+        sprite.posture = '';
+        sprite.tag = '';
+        sprite.offsetX = 0;
+        sprite.offsetY = 0;
+        sprite.flipH = false;
+        sprite.flipV = false;
+        sprite.relativeDepth = 0;
+        sprite.clickHandling = false;
+    }
+
+    private isPreviewLayer(layerId: number): boolean
+    {
+        return (this._shadowLayerIndex >= 0) && (layerId > this._shadowLayerIndex);
+    }
+
+    private getPreviewLayerMask(): number
+    {
+        let mask = 0;
+
+        for(let i = 0; i < FurnitureFurniChestVisualization.PREVIEW_LAYER_COUNT; i++)
+        {
+            mask = mask | (1 << (this._shadowLayerIndex + 1 + i));
+        }
+
+        return mask;
+    }
+
+    private getPreviewOffset(slot: number, scale: number): { x: number, y: number }
+    {
+        if(this._previewItems && this._previewItems.length === 1)
+        {
+            return scale <= 1 ? { x: -5, y: -32 } : { x: -10, y: -76 };
+        }
+
+        const largeOffsets = [
+            { x: -34, y: -74 },
+            { x: -8, y: -86 },
+            { x: 14, y: -68 },
+            { x: -14, y: -56 }
+        ];
+        const iconOffsets = [
+            { x: -16, y: -30 },
+            { x: -4, y: -36 },
+            { x: 8, y: -28 },
+            { x: -6, y: -22 }
+        ];
+        const variants = [
+            { x: 0, y: 0 },
+            { x: 3, y: -4 },
+            { x: -3, y: 3 },
+            { x: 2, y: 2 }
+        ];
+        const base = scale <= 1 ? iconOffsets[slot] : largeOffsets[slot];
+        const variant = variants[(this._previewLayoutVariant + slot) % variants.length];
+
+        return { x: base.x + variant.x, y: base.y + variant.y };
+    }
+
+    private getPreviewAlpha(slot: number): number
+    {
+        const baseAlphas = [ 140, 80, 190, 245 ];
+        const shimmer = Math.sin((this._previewTick + (slot * 11)) / 12) * 12;
+
+        return Math.max(120, Math.min(255, Math.round(baseAlphas[slot] + shimmer)));
+    }
+
+    private isOpen(): boolean
+    {
+        return !!this.object && this.object.getState(0) > 0;
+    }
+
+    private parsePreviewItems(data: string): FurniChestPreviewItem[]
+    {
+        if(!data || data.indexOf('|') === -1) return [];
+
+        const metadata = data.substring(data.indexOf('|') + 1);
+        const result: FurniChestPreviewItem[] = [];
+
+        for(const section of metadata.split(';'))
+        {
+            const parts = section.split('=');
+
+            if(parts.length !== 2 || parts[0] !== 'preview') continue;
+
+            for(const token of parts[1].split(','))
+            {
+                const item = this.parsePreviewItem(token);
+
+                if(item) result.push(item);
+                if(result.length >= FurnitureFurniChestVisualization.PREVIEW_LAYER_COUNT) return result;
+            }
+        }
+
+        return result;
+    }
+
+    private parsePreviewItem(token: string): FurniChestPreviewItem
+    {
+        if(!token) return null;
+
+        const parts = token.split(':');
+        let type = 's';
+        let idPart = token;
+        let extra = '';
+
+        if(parts.length >= 2)
+        {
+            type = parts[0];
+            idPart = parts[1];
+            extra = parts.slice(2).join(':');
+        }
+
+        const classId = parseInt(idPart);
+
+        if(isNaN(classId) || classId <= 0) return null;
+
+        return { type, classId, extra };
+    }
+
+    private loadPreviewTextures(): void
+    {
+        if(!this._previewItems) return;
+
+        this._previewItems.forEach((item, index) =>
+        {
+            const url = this.getPreviewIconUrl(item);
+
+            if(!url) return;
+
+            const image = new Image();
+
+            image.crossOrigin = '*';
+            image.onload = () =>
+            {
+                const texture = Texture.from(image);
+
+                texture.baseTexture.scaleMode = SCALE_MODES.LINEAR;
+                this._previewTextures[index] = texture;
+                this._previewDirty = true;
+            };
+            image.src = url;
+        });
+    }
+
+    private getPreviewIconUrl(item: FurniChestPreviewItem): string
+    {
+        const roomEngine = Nitro.instance && Nitro.instance.roomEngine;
+
+        if(!roomEngine) return null;
+
+        if(item.type === 'i') return roomEngine.getFurnitureWallIconUrl(item.classId, item.extra);
+
+        return roomEngine.getFurnitureFloorIconUrl(item.classId);
+    }
+}
