+    private static isBounceTrajectory(easing: number): boolean
+    {
+        return easing === 9 || easing === 11;
+    }
+
+    private static getBounceHeight(progress: number, curveHeight: number, easing: number, bounceCount: number): number
+    {
+        const x = Math.max(0, Math.min(1, progress));
+        const count = MovingObjectLogic.normalizeBounceCount(bounceCount);
+        const scaledProgress = x * count;
+        const arcIndex = Math.min(count - 1, Math.floor(scaledProgress));
+        const segmentProgress = x >= 1 ? 1 : (scaledProgress - arcIndex);
+        const heightScale = MovingObjectLogic.getBounceArcHeightScale(easing, count, arcIndex);
+        const wave = 4 * segmentProgress * (1 - segmentProgress);
+
+        return wave * curveHeight * heightScale;
+    }
+
+    private static getLateralOffset(progress: number, delta: IVector3D, lateralCurve: number): { x: number; y: number }
+    {
+        const distance = Math.sqrt((delta.x * delta.x) + (delta.y * delta.y));
+
+        if(distance <= 0.001) return { x: 0, y: 0 };
+
+        const envelope = 4 * progress * (1 - progress) * lateralCurve;
+
+        return {
+            x: -(delta.y / distance) * envelope,
+            y: (delta.x / distance) * envelope
+        };
+    }
+
+    private static getBounceUpdateInterval(easing: number, bounceCount: number): number
+    {
+        const count = MovingObjectLogic.normalizeBounceCount(bounceCount);
+        let interval = 0;
+
+        for(let i = 0; i < count; i++) interval += MovingObjectLogic.getBounceArcInterval(easing, count, i);
+
+        return Math.max(MovingObjectLogic.DEFAULT_UPDATE_INTERVAL, interval);
+    }
+
+    private static getBounceDistanceProgressAtTimeProgress(progress: number, easing: number, bounceCount: number): number
+    {
+        const x = Math.max(0, Math.min(1, progress));
+        const count = MovingObjectLogic.normalizeBounceCount(bounceCount);
+
+        if(count === 1) return x;
+
+        const totalInterval = MovingObjectLogic.getBounceUpdateInterval(easing, count);
+        const targetTime = x * totalInterval;
+        let elapsed = 0;
+
+        for(let i = 0; i < count; i++)
+        {
+            const arcInterval = MovingObjectLogic.getBounceArcInterval(easing, count, i);
+
+            if(targetTime <= (elapsed + arcInterval))
+            {
+                const arcProgress = arcInterval <= 0 ? 1 : ((targetTime - elapsed) / arcInterval);
+
+                return Math.max(0, Math.min(1, (i + arcProgress) / count));
+            }
+
+            elapsed += arcInterval;
+        }
+
+        return 1;
+    }
+
+    private static getBounceArcInterval(easing: number, bounceCount: number, arcIndex: number): number
+    {
+        const heightScale = MovingObjectLogic.getBounceArcHeightScale(easing, bounceCount, arcIndex);
+
+        return MovingObjectLogic.MIN_BOUNCE_ARC_INTERVAL
+            + ((MovingObjectLogic.DEFAULT_UPDATE_INTERVAL - MovingObjectLogic.MIN_BOUNCE_ARC_INTERVAL) * heightScale);
+    }
+
+    private static getBounceArcHeightScale(easing: number, bounceCount: number, arcIndex: number): number
+    {
+        const count = MovingObjectLogic.normalizeBounceCount(bounceCount);
+
+        if(count === 1) return 1;
+
+        const heightProgress = arcIndex / (count - 1);
+
+        return easing === 11
+            ? (0.1 + (0.9 * heightProgress))
+            : (1 - (0.9 * heightProgress));
+    }
+
+    private static getRouteProgressAtDistanceProgress(progress: number, delta: IVector3D, lateralCurve: number): number
+    {
+        const x = Math.max(0, Math.min(1, progress));
+
+        if(Math.abs(lateralCurve) <= 0.001) return x;
+
+        const distance = Math.sqrt((delta.x * delta.x) + (delta.y * delta.y));
+
+        if(distance <= 0.001) return x;
+
+        const samples = MovingObjectLogic.BOUNCE_PATH_SAMPLES;
+        let previous = MovingObjectLogic.getRoutePoint(0, delta, lateralCurve);
+        let totalLength = 0;
+        const lengths: number[] = [ 0 ];
+
+        for(let i = 1; i <= samples; i++)
+        {
+            const point = MovingObjectLogic.getRoutePoint(i / samples, delta, lateralCurve);
+            totalLength += MovingObjectLogic.getPointDistance(previous, point);
+            lengths[i] = totalLength;
+            previous = point;
+        }
+
+        if(totalLength <= 0.001) return x;
+
+        const targetLength = x * totalLength;
+
+        for(let i = 1; i <= samples; i++)
+        {
+            if(targetLength <= lengths[i])
+            {
+                const segmentLength = lengths[i] - lengths[i - 1];
+                const segmentProgress = segmentLength <= 0.001 ? 0 : ((targetLength - lengths[i - 1]) / segmentLength);
+
+                return ((i - 1) + segmentProgress) / samples;
+            }
+        }
+
+        return 1;
+    }
+
+    private static getRoutePoint(progress: number, delta: IVector3D, lateralCurve: number): { x: number; y: number }
+    {
+        const lateralOffset = MovingObjectLogic.getLateralOffset(progress, delta, lateralCurve);
+
+        return {
+            x: (delta.x * progress) + lateralOffset.x,
+            y: (delta.y * progress) + lateralOffset.y
+        };
+    }
+
+    private static getPointDistance(from: { x: number; y: number }, to: { x: number; y: number }): number
+    {
+        const dx = to.x - from.x;
+        const dy = to.y - from.y;
+
+        return Math.sqrt((dx * dx) + (dy * dy));
+    }
+
+    private static normalizeBounceCount(bounceCount: number): number
+    {
+        const count = Math.round(Number(bounceCount) || MovingObjectLogic.DEFAULT_BOUNCE_COUNT);
+
+        return Math.max(MovingObjectLogic.MIN_BOUNCE_COUNT, Math.min(MovingObjectLogic.MAX_BOUNCE_COUNT, count));
+    }
+
+    private static easeOutBounce(x: number): number
+    {
+        const n1 = 7.5625;
+        const d1 = 2.75;
+
+        if(x < (1 / d1)) return n1 * x * x;
+        if(x < (2 / d1)) return (n1 * (x -= 1.5 / d1) * x) + 0.75;
+        if(x < (2.5 / d1)) return (n1 * (x -= 2.25 / d1) * x) + 0.9375;
+
+        return (n1 * (x -= 2.625 / d1) * x) + 0.984375;
+    }
+
+    protected getLocationOffset(): IVector3D
+    {
+        return null;
+    }
+
+    protected get lastUpdateTime(): number
+    {
+        return this._lastUpdateTime;
+    }
+
+    protected set updateInterval(interval: number)
+    {
+        if(interval <= 0) interval = 1;
+
+        this._updateInterval = interval;
+    }
+}
