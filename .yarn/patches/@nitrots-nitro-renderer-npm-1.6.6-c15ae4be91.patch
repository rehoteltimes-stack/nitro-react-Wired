+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        let totalOffers = wrapper.readInt();
+
+        while(totalOffers > 0)
+        {
+            this._groups.push(new HabboGroupEntryData(wrapper));
+
+            totalOffers--;
+        }
+
+        return true;
+    }
+
+    public get groups(): HabboGroupEntryData[]
+    {
+        return this._groups;
+    }
+}
