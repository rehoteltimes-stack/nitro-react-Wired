+import { IMessageDataWrapper, IMessageParser } from '../../../../../api';
+
+export interface AreaHideFloorHole
+{
+    id: number;
+    x: number;
+    y: number;
+    width: number;
+    height: number;
+    invert: boolean;
+}
+
+export class AreaHideFloorHolesParser implements IMessageParser
+{
+    private _holes: AreaHideFloorHole[];
+
+    public flush(): boolean
+    {
+        this._holes = [];
+        return true;
+    }
+
+    public parse(wrapper: IMessageDataWrapper): boolean
+    {
+        if(!wrapper) return false;
+
+        const count = wrapper.readInt();
+        this._holes = [];
+
+        for(let i = 0; i < count; i++)
+        {
+            this._holes.push({
+                id: wrapper.readInt(),
+                x: wrapper.readInt(),
+                y: wrapper.readInt(),
+                width: wrapper.readInt(),
+                height: wrapper.readInt(),
+                invert: wrapper.readInt() === 1
+            });
+        }
+
+        return true;
+    }
+
+    public get holes(): AreaHideFloorHole[]
+    {
+        return this._holes;
+    }
+}
