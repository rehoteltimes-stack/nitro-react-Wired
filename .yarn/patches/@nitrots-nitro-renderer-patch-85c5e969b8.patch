diff --git a/nitro/avatar/data/HabboAvatarExtraParts.ts b/nitro/avatar/data/HabboAvatarExtraParts.ts
index 67beed0f6e1f18c51954215ff51dffcb6fe1c935..3d78c76ff9ed64570afb571a3e17d2f9c037fc22 100644
--- a/nitro/avatar/data/HabboAvatarExtraParts.ts
+++ b/nitro/avatar/data/HabboAvatarExtraParts.ts
@@ -60,3 +60,58 @@ export const AddExtraPartSets = (partSets: any) =>
 
     return partSets;
 };
+
+const EXTRA_TYPES = [ 'pt', 'ptl', 'ptr', 'mc', 'mcl', 'mcr' ];
+
+const MIRROR_SOURCES: { [type: string]: string } = {
+    'pt': 'bd',
+    'mc': 'bd',
+    'ptl': 'lh',
+    'mcl': 'lh',
+    'ptr': 'rh',
+    'mcr': 'rh'
+};
+
+const IDLE_ANIMATIONS: { [id: string]: string } = {
+    'Default': 'std',
+    'Sit': 'sit',
+    'Lay': 'lay'
+};
+
+const IDLE_FRAMES = 8;
+
+export const IsExtraIdleAnimation = (id: string) => (IDLE_ANIMATIONS[id] !== undefined);
+
+export const HasExtraParts = (partTypeIds: Iterable<string>) => Array.from(partTypeIds).some(type => ((type === 'pt') || (type === 'mc')));
+
+export const AddExtraAnimations = (animations: any[]) =>
+{
+    for(const animation of animations)
+    {
+        if(!animation.parts) continue;
+
+        for(const type of EXTRA_TYPES)
+        {
+            if(animation.parts.some(part => (part.setType === type))) continue;
+
+            const source = animation.parts.find(part => (part.setType === MIRROR_SOURCES[type]));
+
+            if(!source || !source.frames) continue;
+
+            animation.parts.push({ 'setType': type, 'frames': source.frames.map(frame => ({ ...frame })) });
+        }
+    }
+
+    for(const id in IDLE_ANIMATIONS)
+    {
+        if(animations.some(animation => (animation.id === id))) continue;
+
+        const frames = [];
+
+        for(let i = 0; i < IDLE_FRAMES; i++) frames.push({ 'number': i, 'assetPartDefinition': IDLE_ANIMATIONS[id] });
+
+        animations.push({ 'id': id, 'parts': EXTRA_TYPES.map(type => ({ 'setType': type, 'frames': frames.map(frame => ({ ...frame })) })) });
+    }
+
+    return animations;
+};
